{
  "compilerOptions": {
    "target": "ES2015",
    "lib": [
      "dom",
      "es2025"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "**/*.ts",
    "./src/*.tsx",
    "**/.*.js",
    "**/*.js",
    "**/.*.cjs",
  ]
}
